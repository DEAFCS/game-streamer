+// Poke the consumer's eventfd for a present, adding the grid slots it advances (1
+// unless skip-pacing skipped slots). Runs on cs2's present/render thread (or the
+// handoff thread), so it MUST never block: the fd is EFD_NONBLOCK and the counter
+// coalesces, so a slow consumer can never back-pressure the render. Errors are
+// swallowed (the next present re-pokes).
+static void signal_present_slots(uint64_t slots)
+{
+    if (data.present_eventfd < 0) {
+        return;
+    }
+    ssize_t r = write(data.present_eventfd, &slots, sizeof(slots));
+    if (r == sizeof(slots)) {
+        data.pokes_sent += slots;
+    }
