+// ---- frame handoff ---------------------------------------------------------
+// The shared image is ONE buffer that the GPU copy overwrites on every present,
+// while the consumer reads it on the CPU after our poke. Poking right after
+// QueueSubmit (as above) lets the consumer read a copy still in flight: the previous
+// frame, or a torn mix when the copy lands mid-read. With handoff on (the consumer
+// sent an ack socket), a helper thread waits for the copy's fence, then pokes, then
+// waits for the consumer to report the read done; the next present drains it before
+// submitting its copy, so the image never changes under a read. The present thread
+// itself never waits on the GPU, only on the previous frame's handoff.
+#define HANDOFF_ACK_TIMEOUT_MS 20
+
+bool capture_frame_ack_enabled()
+{
+    return data.present_eventfd >= 0 && data.ack_fd >= 0 && !data.ack_dead;
+}
+
+// Wait (bounded) until the consumer reports every poke so far as read. It sends its
+// running total, so a late ack for an older frame can never satisfy a newer one.
+static void capture_wait_frame_ack(int timeout_ms)
+{
+    if (!capture_frame_ack_enabled()) {
+        return;
+    }
+    const int64_t deadline = pace_now_ns() + (int64_t)timeout_ms * 1000000LL;
+    for (;;) {
+        uint64_t total = 0;
+        ssize_t r;
+        while ((r = recv(data.ack_fd, &total, sizeof(total), MSG_DONTWAIT)) == sizeof(total)) {
+            if (total > data.pokes_acked) {
+                data.pokes_acked = total;
+            }
+        }
+        if (r == 0 || (r < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) {
+            data.ack_dead = true;   // consumer went away: don't stall presents on it
+            return;
+        }
+        if (data.pokes_acked >= data.pokes_sent) {
+            return;
+        }
+        const int64_t left = deadline - pace_now_ns();
+        if (left <= 0) {
+            return;
+        }
+        struct pollfd pfd = { .fd = data.ack_fd, .events = POLLIN };
+        poll(&pfd, 1, (int)((left + 999999) / 1000000));
+    }
+}
+
+static struct {
+    pthread_mutex_t mutex;
+    pthread_cond_t cond;
+    bool started;
+    bool pending;
+    void (*wait_copy)(void *opaque, uint64_t token);
+    void *opaque;
+    uint64_t token;
+    uint64_t slots;
+} handoff = { PTHREAD_MUTEX_INITIALIZER, PTHREAD_COND_INITIALIZER, false, false, NULL, NULL, 0, 1 };
+
+static void *handoff_main(void *arg)
+{
+    (void)arg;
+    pthread_mutex_lock(&handoff.mutex);
+    for (;;) {
+        while (!handoff.pending) {
+            pthread_cond_wait(&handoff.cond, &handoff.mutex);
+        }
+        void (*wait_copy)(void *, uint64_t) = handoff.wait_copy;
+        void *opaque = handoff.opaque;
+        const uint64_t token = handoff.token;
+        const uint64_t slots = handoff.slots;
+        pthread_mutex_unlock(&handoff.mutex);
+
+        wait_copy(opaque, token);                       // the copy is in the image
+        signal_present_slots(slots);                    // so the consumer may read it
+        capture_wait_frame_ack(HANDOFF_ACK_TIMEOUT_MS); // and the next copy waits for it
+
+        pthread_mutex_lock(&handoff.mutex);
+        handoff.pending = false;
+        pthread_cond_broadcast(&handoff.cond);
     }
+    return NULL;
+}
+
+// Called right after the frame's copy is submitted. wait_copy(opaque, token) must
+// block until that copy completes. Without handoff (or a copy to wait on) this is
+// the old immediate poke.
+void capture_handoff_frame(void (*wait_copy)(void *opaque, uint64_t token),
+        void *opaque, uint64_t token)
+{
+    if (!wait_copy || !capture_frame_ack_enabled()) {
+        capture_signal_present();
+        return;
+    }
+    pthread_mutex_lock(&handoff.mutex);
+    if (!handoff.started) {
+        // The helper must not take the game's signals.
+        sigset_t all, old;
+        sigfillset(&all);
+        pthread_sigmask(SIG_SETMASK, &all, &old);
+        pthread_t thread;
+        handoff.started = pthread_create(&thread, NULL, handoff_main, NULL) == 0;
+        pthread_sigmask(SIG_SETMASK, &old, NULL);
+        if (handoff.started) {
+            pthread_detach(thread);
+        } else {
+            hlog("frame handoff: pthread_create failed, poking immediately");
+        }
+    }
+    if (!handoff.started) {
+        pthread_mutex_unlock(&handoff.mutex);
+        capture_signal_present();
+        return;
+    }
+    handoff.wait_copy = wait_copy;
+    handoff.opaque = opaque;
+    handoff.token = token;
+    handoff.slots = data.pace_slots ? data.pace_slots : 1;   // this frame's, before the next pace
+    handoff.pending = true;
+    pthread_cond_signal(&handoff.cond);
+    pthread_mutex_unlock(&handoff.mutex);
+}
+
+// Block until the helper has finished the previous frame. Called before anything
+// touches the fds, the copy fences or the shared image (bounded by the fence wait
+// and HANDOFF_ACK_TIMEOUT_MS).
+void capture_handoff_drain()
+{
+    pthread_mutex_lock(&handoff.mutex);
+    while (handoff.pending) {
+        pthread_cond_wait(&handoff.cond, &handoff.mutex);
+    }
+    pthread_mutex_unlock(&handoff.mutex);
 }
 
