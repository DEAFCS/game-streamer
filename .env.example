# Copy to src/.env and fill in. Loaded automatically by game-streamer.sh.

# --- flow 1: setup-steam ---------------------------------------------------
export STEAM_USER=cs2_servers
export STEAM_PASSWORD=

# --- flow 2: run-live ------------------------------------------------------
export MATCH_ID=

# Pick ONE of these two pairs:
# export PLAYCAST_URL=
# - or -
export CONNECT_ADDR=
export CONNECT_PASSWORD=

# --- optional overrides ----------------------------------------------------
# export DEBUG_STREAM_ID=debug
# export FPS=30
# CS2_FPS_MAX (demo clips) defaults to 120 — see the demo-smoothness section below.
# export VIDEO_KBPS=6000
# --- Per-node auto-tune (cs2_autotune in src/lib/cs2-tune.sh) --------------
# On launch the node's GPU class + CPU core count are detected and the knobs
# below are filled in per node. Anything you export here ALWAYS wins.
#
# GPU scale+convert: when the NVENC encoder is CUDA-based, the capture
# scale (e.g. 1440p->1080p) and RGB->NV12 convert run on the GPU
# (cudaconvertscale) instead of the CPU, freeing cores for cs2. Auto-tune
# sets 'auto' on modern GPUs and '0' (CPU) on weak Maxwell-class cards.
# export GS_GPU_SCALE=0
#
# cs2 worker threads. Left to the engine by default (we never pass -threads) —
# auto-detect is Valve's recommendation and a high explicit -threads is a known
# cs2 stutter source. Escape hatch only: set CS2_THREADS=N to force -threads N on
# a misbehaving node.
# export CS2_THREADS=6
#
# GPU clock lock (lock_gpu_clocks in cs2-tune.sh): pins the GPU graphics clock
# so it doesn't downclock at low utilisation and then oscillate ramping back up
# under bursty load — that P-state oscillation reads as intermittent stutter
# even at <50% GPU use. Headless equivalent of PowerMizer "Prefer Maximum
# Performance" (nvidia-smi -pm 1 + -lgc). On by default; set 0 to disable, or
# pin a specific MHz (defaults to the card's max).
# export GS_GPU_LOCK_CLOCKS=0
# export GS_GPU_LOCK_MHZ=2400
#
# --- Clip capture method (the gunfight-stutter fix) -------------------------
# PROVEN cause of the clip stutter: ximagesrc's X11 XShmGetImage grab serializes
# with cs2's frame-present on the single-threaded X server, so at heavy moments
# cs2's render BLOCKS waiting on it (DIAG showed gpu util -> 0%, cs2 idle, 9fps).
# The fix is to capture frames where they already live — inside cs2's Vulkan
# present — so capture can never contend with the render on the X server.
#
# CLIP_CAPTURE_METHOD=vkcapture (DEFAULT): the obs-vkcapture Vulkan LAYER, loaded
# into cs2 via the OBS_VKCAPTURE=1 launch option (set by set_cs2_launch_options),
# hooks vkQueuePresentKHR and shares the swapchain image over a unix socket. Our
# vkcapture-consumer (built into the image) binds that socket and feeds frames
# into the SAME NVENC pipeline as before. No X server involvement => no stall.
#   HOST PREREQUISITE: nvidia-drm.modeset=1 on the host kernel cmdline (a SUPPORTED
#   NVIDIA setting — needed for DRM/dmabuf — NOT a binary driver patch). Verify:
#     cat /sys/module/nvidia_drm/parameters/modeset      # want: Y
#   If N: add `nvidia-drm.modeset=1` to GRUB_CMDLINE_LINUX, update-grub, reboot.
#   On-node debug: `VKCAP_TEST=1 vkcapture-consumer` logs the layer's frame
#   geometry (fourcc/modifier/nfd) and dumps one frame — run it (with cs2 up under
#   OBS_VKCAPTURE=1) to confirm the present-hook link before chasing the encode.
#
# CLIP_CAPTURE_METHOD=ximagesrc: the old gstreamer X11 grab (the original stutter
# source). Universal fallback — used automatically if vkcapture-consumer or the
# host prereq is missing.
# export CLIP_CAPTURE_METHOD=ximagesrc
# export STEAM_LIBRARY=/mnt/game-streamer
# export CS2_DIR="$STEAM_LIBRARY/steamapps/common/Counter-Strike Global Offensive"
# export MEDIAMTX_SRT_BASE=srt://mediamtx.5stack.svc.cluster.local:8890

# --- Demo clip (highlight) smoothness ---------------------------------------
# The dominant clip stutter was a CAPTURE-induced render stall (ximagesrc's X11
# readback serializing with cs2's present) — fixed by the vkcapture present-hook
# above. The knobs below are secondary render tuning (all demo-only; live
# capture is untouched):
#
# Render cap: 120 (default) = a 2x buffer over the 60Hz capture so every sample is
# a fresh frame, without wasting GPU on fps we'd never capture. 0 = uncapped.
# export CS2_FPS_MAX=120
#
# TrueView (cl_demo_predict): 0 = off (default — it made playback jitter and dropped
# the POV player's gunshots), 1 = only on a demo/client build match, 2 = always.
# export CS2_DEMO_PREDICT=0
#
# Debug overlay: 1 bakes cl_showfps + net_graph into the clip (off by default).
# export CS2_DEBUG_OVERLAY=1
#
# Capture diagnostics: per-second GPU/VRAM/clock + cs2/capture CPU into the
# render log (on by default; set 0 to mute).
# export CLIP_CAPTURE_DIAG=0
#
# NVIDIA's Vulkan shader disk cache is disabled for root unless
# __GL_SHADER_DISK_CACHE=1 is on the cs2 process, and Steam strips it — so
# setup-steam.sh injects it (plus OBS_VKCAPTURE=1) via cs2's launch options.
# Override the whole launch-option string here:
# export CS2_LAUNCH_OPTIONS="__GL_SHADER_DISK_CACHE=1 %command%"

# --- Vulkan shader pre-caching ---------------------------------------------
# Shaders always compile on launch so the persistent GLCache warms (first
# cold compile per GPU/driver is slow, later launches reuse it). Operators
# skip a compile per-match from the UI.
# export GL_SHADER_CACHE_DIR=/mnt/game-streamer/nvcache  # GLCache location
# export __GL_SHADER_DISK_CACHE_SIZE=10737418240         # 10 GiB cap
#
# DEBUG_STREAM=1 captures from boot (before Steam) so a boot hang is
# watchable via the "WATCH (HLS)" URL in the logs.
# export DEBUG_STREAM=1
# export DEBUG_STREAM_ID=debug      # publish path (default: MATCH_ID)

# --- Broadcast HUD ----------------------------------------------------------
# Stamped by the api; set by hand only when running a pod directly.
# export HUD_MODE=horizontal          # builtin layout the boot overlay opens: horizontal | vertical
# export HUD_ID=default               # JTs Hud Manager hud id of the chosen HUD
# export HUD_VARIANT=                 # layout within HUD_ID; empty for an imported HUD
# export HUD_SLUG=my-hud              # imported HUD only
# export HUD_BUNDLE_URL=https://...   # imported HUD only: presigned archive URL
